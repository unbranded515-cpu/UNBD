# ─── Claude API (required for live AI replies & SEO recommendations) ───
# Get a key at https://console.anthropic.com  →  Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used for generation. Default is Claude Opus 5 (highest quality).
# For high-volume review replies you can cut cost dramatically with a smaller
# model — quality stays strong for short replies:
#   claude-opus-5      $5 / $25 per 1M tokens   (default, best)
#   claude-sonnet-5    $2 / $10                 (great balance)
#   claude-haiku-4-5   $1 / $5                  (cheapest, fine for replies)
ANTHROPIC_MODEL=claude-opus-5

# ─── Google Business Profile API (Phase 2 — live review sync & posting) ───
# Not required to run the app. Reviews work in draft mode without these.
# You must apply for access: https://developers.google.com/my-business
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
