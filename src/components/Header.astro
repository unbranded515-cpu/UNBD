---
import { site, nav } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-charcoal/10 bg-cream/95 backdrop-blur supports-[backdrop-filter]:bg-cream/80">
  <div class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-charcoal" aria-label={`${site.name} home`}>
      <!-- Real logo; falls back to the mark + wordmark until /images/logo.png is uploaded. -->
      <img
        src="/images/logo.png"
        alt={site.name}
        class="h-14 w-auto sm:h-16"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
      />
      <span class="hidden items-center gap-2 text-charcoal" style="display:none">
        <span class="grid h-9 w-9 place-items-center rounded-lg bg-charcoal text-gold" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 22 9l-10 13L2 9z" /></svg>
        </span>
        <span class="flex flex-col leading-none">
          <span class="text-base font-extrabold tracking-tight">Diamond Sofa</span>
          <span class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted">Kingston, ON</span>
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-full px-3 py-2 text-sm font-medium transition-colors hover:bg-charcoal/5',
              isActive(item.href) ? 'text-gold-dark' : 'text-charcoal',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={site.phoneHref}
      class="hidden items-center gap-2 rounded-full bg-gold px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-gold-dark sm:inline-flex"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.24 1z" />
      </svg>
      {site.phone}
    </a>

    <!-- Mobile menu (CSS-only, no JS) -->
    <details class="relative lg:hidden">
      <summary class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-lg border border-charcoal/15 text-charcoal marker:hidden [&::-webkit-details-marker]:hidden">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        <span class="sr-only">Open menu</span>
      </summary>
      <div class="absolute right-0 top-12 w-56 rounded-xl border border-charcoal/10 bg-paper p-2 shadow-cardHover">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'block rounded-lg px-3 py-2 text-sm font-medium hover:bg-cream',
                isActive(item.href) ? 'text-gold-dark' : 'text-charcoal',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <a href="/contact" class="block rounded-lg px-3 py-2 text-sm font-medium text-charcoal hover:bg-cream">Contact</a>
        <a href={site.phoneHref} class="mt-1 block rounded-lg bg-gold px-3 py-2 text-center text-sm font-semibold text-white hover:bg-gold-dark">
          Call {site.phone}
        </a>
      </div>
    </details>
  </div>
</header>
