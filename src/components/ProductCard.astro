---
import Placeholder from './Placeholder.astro';
import { site } from '../data/site';

interface Product {
  id: string;
  name: string;
  category: string;
  price: number | null;
  compareAtPrice?: number | null;
  clearance?: boolean;
  inStock?: boolean;
  customSizes?: boolean;
  description: string;
  image: string;
  tags?: string[];
}
interface Props {
  product: Product;
}
const { product } = Astro.props;
const hasPrice = typeof product.price === 'number';
const priceLabel = hasPrice ? `$${product.price}` : 'Call for price';
---
<article class="group flex flex-col overflow-hidden rounded-xl2 bg-paper shadow-card transition-shadow duration-200 hover:shadow-cardHover">
  <Placeholder label={product.name} src={product.image} alt={product.name} ratio="4/3" rounded={false} />

  <div class="flex flex-1 flex-col gap-3 p-5">
    {
      product.tags && product.tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5" aria-label="Product features">
          {product.tags.map((tag) => (
            <li class="rounded-full bg-cream px-2.5 py-1 text-xs font-medium text-muted">{tag}</li>
          ))}
        </ul>
      )
    }

    <h3 class="text-lg font-semibold leading-snug text-charcoal">{product.name}</h3>
    <p class="text-sm leading-relaxed text-muted">{product.description}</p>

    <div class="mt-auto flex items-baseline gap-2 pt-1">
      <span class="text-xl font-bold text-charcoal">{priceLabel}</span>
      {
        product.compareAtPrice && (
          <span class="text-sm text-muted line-through">${product.compareAtPrice}</span>
        )
      }
    </div>

    <div class="mt-1 flex flex-col gap-2.5">
      <a
        href={site.phoneHref}
        class="inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-full bg-gold px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-gold-dark"
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.24 1z" />
        </svg>
        Call {site.phone}
      </a>
      <a
        href={site.instagramUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-gold-dark hover:text-gold"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="3.5" /><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" /></svg>
        Message us on Instagram
      </a>
    </div>
  </div>
</article>
