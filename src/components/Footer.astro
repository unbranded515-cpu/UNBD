---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-charcoal/10 bg-charcoal text-cream">
  <div class="mx-auto grid max-w-content gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2">
        <img
          src="/images/logo.png"
          alt={site.name}
          class="h-16 w-auto"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
        />
        <span class="hidden items-center gap-2" style="display:none">
          <span class="grid h-9 w-9 place-items-center rounded-lg bg-gold text-charcoal" aria-hidden="true">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 22 9l-10 13L2 9z" /></svg>
          </span>
          <span class="text-lg font-extrabold tracking-tight">Diamond Sofas MFG</span>
        </span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream/70">
        Family-owned furniture makers for 30 years. Sofas, beds, mattresses and dining sets
        at factory prices, built and delivered from our Kingston showroom.
      </p>
      <p class="mt-4 text-sm text-cream/60">Family-owned · Kingston, ON</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-cream/50">Shop</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {nav.map((item) => (
          <li><a href={item.href} class="text-cream/80 hover:text-gold-light">{item.label}</a></li>
        ))}
        <li><a href="/contact" class="text-cream/80 hover:text-gold-light">Contact</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-cream/50">Visit &amp; contact</h2>
      <address class="mt-4 space-y-2 text-sm not-italic text-cream/80">
        <p>{site.address.line}<br />{site.address.city}, {site.address.province}</p>
        <p class="text-cream/60">{site.address.directions}</p>
        <p><a href={site.phoneHref} class="font-semibold text-gold-light hover:text-gold">{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`} class="hover:text-gold-light">{site.email}</a></p>
        <p><a href={site.instagramUrl} class="hover:text-gold-light">{site.instagram}</a></p>
        <p class="text-cream/60">{site.hours}</p>
      </address>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="mx-auto max-w-content px-4 py-6 text-xs text-cream/50 sm:px-6">
      © {year} {site.name}. All rights reserved.
    </div>
  </div>
</footer>
