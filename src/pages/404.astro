---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout
  title="Page Not Found — Diamond Sofas MFG, Kingston"
  description="That page can't be found. Browse our furniture or call Diamond Sofas MFG in Kingston at 647-210-9552."
>
  <section class="container-x flex min-h-[55vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-gold-dark">404</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-charcoal sm:text-4xl">We can't find that page</h1>
    <p class="mt-4 max-w-md text-lg text-muted">It may have moved. Try the showroom, our clearance deals, or give us a call.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/clearance" class="btn-secondary">Shop clearance</a>
      <a href={site.phoneHref} class="btn-secondary">Call {site.phone}</a>
    </div>
  </section>
</BaseLayout>
